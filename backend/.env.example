# Salin ke .env lalu isi. Jangan commit .env.

# Lokal: postgres://postgres:postgres@127.0.0.1:54322/postgres (supabase start)
# Produksi: connection string Supabase. Bila memakai pooler port 6543
# (mode transaction), set DB_SIMPLE_PROTOCOL=true.
DATABASE_URL=
DB_SIMPLE_PROTOCOL=false

# Minimal 32 karakter acak, mis. hasil: openssl rand -base64 48
JWT_SECRET=
# Lama sesi (bawaan 720h = 30 hari)
JWT_TTL=720h

# Origin frontend yang boleh memanggil API (pisahkan dengan koma)
ALLOWED_ORIGINS=http://localhost:3000

ADDR=:8080

# Login Google: OAuth Client ID (tipe "Web application") dari Google Cloud
# Console, dengan Authorized JavaScript origins = URL frontend. Kosong = nonaktif.
GOOGLE_CLIENT_ID=

# Login nomor telepon (OTP). "log" = kode ditulis ke log server (HANYA dev).
# Kosong = nonaktif. Produksi: tambahkan pengirim SMS/WA di pkg/auth/sms.go.
OTP_SENDER=

# Lampiran PDF panduan (maks. 50 MB) — browser mengunggah langsung ke storage.
#   supabase : produksi. Buat bucket PRIVAT "guideline-attachments" (lihat migrasi 008).
#   local    : pengembangan; file disimpan di LOCAL_STORAGE_DIR (tidak untuk Vercel).
#   kosong   : unggah lampiran nonaktif.
STORAGE_DRIVER=local
STORAGE_BUCKET=guideline-attachments
SUPABASE_URL=
# Service role key — RAHASIA, hanya di server, jangan pernah di frontend.
SUPABASE_SERVICE_ROLE_KEY=
LOCAL_STORAGE_DIR=./data/uploads

# IP klien di jejak audit: header proxy hanya dipercaya di Vercel (otomatis)
# atau bila diset true di balik reverse proxy tepercaya.
# TRUST_PROXY_HEADERS=true
